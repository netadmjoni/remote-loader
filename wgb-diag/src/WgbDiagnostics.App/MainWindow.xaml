<Window x:Class="WgbDiagnostics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Width="960"
        Height="900"
        MinWidth="640"
        MinHeight="720">
  <Window.Resources>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Settings"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <GroupBox Grid.Row="1" Header="ICMP monitor" Margin="0,0,0,12">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
          <Button x:Name="StartMonitoringButton" Content="Start monitoring" Click="StartMonitoringButton_Click" />
          <Button x:Name="StopMonitoringButton" Content="Stop monitoring" Click="StopMonitoringButton_Click" IsEnabled="False" />

          <TextBlock Text="Status:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="MonitorStatusTextBlock" Text="Stopped" VerticalAlignment="Center" MinWidth="80" />

          <TextBlock Text="RTT:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="CurrentRttTextBlock" Text="-" VerticalAlignment="Center" MinWidth="72" />

          <TextBlock Text="OK:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="TotalOkTextBlock" Text="0" VerticalAlignment="Center" MinWidth="48" />

          <TextBlock Text="Lost:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="TotalLostTextBlock" Text="0" VerticalAlignment="Center" MinWidth="48" />

          <TextBlock Text="Consecutive loss:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="ConsecutiveLossTextBlock" Text="0" VerticalAlignment="Center" MinWidth="48" />

          <TextBlock Text="Longest outage:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="LongestOutageTextBlock" Text="0 ms" VerticalAlignment="Center" MinWidth="72" />

          <TextBlock Text="Runtime:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="RuntimeTextBlock" Text="00:00:00" VerticalAlignment="Center" MinWidth="80" />
        </WrapPanel>

        <ListBox Grid.Row="1"
                 x:Name="ProbeEventsListBox"
                 Height="120"
                 Margin="0,8,0,0" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="2" Header="WGB status" Margin="0,0,0,12">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
          <Button x:Name="TestSshButton" Content="Test SSH" Click="TestSshButton_Click" />
          <Button x:Name="StartWgbPollingButton" Content="Start WGB polling" Click="StartWgbPollingButton_Click" />
          <Button x:Name="StopWgbPollingButton" Content="Stop WGB polling" Click="StopWgbPollingButton_Click" IsEnabled="False" />

          <TextBlock Text="SSH/WGB status:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="WgbStatusTextBlock" Text="Not tested" VerticalAlignment="Center" MinWidth="180" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Parent AP:" FontWeight="SemiBold" Margin="0,0,4,6" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ParentApTextBlock" Text="-" Margin="0,0,16,6" />

          <TextBlock Grid.Row="0" Grid.Column="2" Text="RSSI:" FontWeight="SemiBold" Margin="0,0,4,6" />
          <TextBlock Grid.Row="0" Grid.Column="3" x:Name="RssiTextBlock" Text="-" Margin="0,0,16,6" />

          <TextBlock Grid.Row="0" Grid.Column="4" Text="Channel:" FontWeight="SemiBold" Margin="0,0,4,6" />
          <TextBlock Grid.Row="0" Grid.Column="5" x:Name="ChannelTextBlock" Text="-" Margin="0,0,16,6" />

          <TextBlock Grid.Row="0" Grid.Column="6" Text="Radio ID:" FontWeight="SemiBold" Margin="0,0,4,6" />
          <TextBlock Grid.Row="0" Grid.Column="7" x:Name="RadioIdTextBlock" Text="-" Margin="0,0,0,6" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Tx rate:" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxRateTextBlock" Text="-" Margin="0,0,16,0" />

          <TextBlock Grid.Row="1" Grid.Column="2" Text="Rx rate:" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Grid.Row="1" Grid.Column="3" x:Name="RxRateTextBlock" Text="-" Margin="0,0,16,0" />

          <TextBlock Grid.Row="1" Grid.Column="4" Text="WGB IP:" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Grid.Row="1" Grid.Column="5" x:Name="WgbIpTextBlock" Text="-" Margin="0,0,16,0" />

          <TextBlock Grid.Row="1" Grid.Column="6" Text="Association:" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Grid.Row="1" Grid.Column="7" x:Name="AssociationStatusTextBlock" Text="Unknown" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Parent BSSID:" FontWeight="SemiBold" Margin="0,6,4,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ParentBssidTextBlock" Text="-" Margin="0,6,16,0" />

          <TextBlock Grid.Row="2" Grid.Column="2" Text="Candidate AP:" FontWeight="SemiBold" Margin="0,6,4,0" />
          <TextBlock Grid.Row="2" Grid.Column="3" x:Name="CandidateApTextBlock" Text="-" Margin="0,6,16,0" />

          <TextBlock Grid.Row="2" Grid.Column="4" Text="Candidate BSSID:" FontWeight="SemiBold" Margin="0,6,4,0" />
          <TextBlock Grid.Row="2" Grid.Column="5" x:Name="CandidateBssidTextBlock" Text="-" Margin="0,6,16,0" />
        </Grid>

        <Expander Grid.Row="2" Header="Advanced raw WGB output" Margin="0,8,0,0">
          <StackPanel>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="LoadSampleOutputButton" Content="Load sample output" Click="LoadSampleOutputButton_Click" />
              <Button x:Name="ParseSampleOutputButton" Content="Parse sample output" Click="ParseSampleOutputButton_Click" />
            </WrapPanel>

            <TextBox x:Name="RawWgbOutputTextBox"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Matched fields" FontWeight="SemiBold" Margin="0,0,8,4" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="Missing fields" FontWeight="SemiBold" Margin="0,0,8,4" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Unclassified lines" FontWeight="SemiBold" Margin="0,0,0,4" />

              <TextBox Grid.Row="1" Grid.Column="0" x:Name="MatchedFieldsTextBox" Height="80" IsReadOnly="True" AcceptsReturn="True" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="MissingFieldsTextBox" Height="80" IsReadOnly="True" AcceptsReturn="True" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto" />
              <TextBox Grid.Row="1" Grid.Column="2" x:Name="UnclassifiedLinesTextBox" Height="80" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </Grid>
          </StackPanel>
        </Expander>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="3" Header="Realtime graph" Margin="0,0,0,12">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <Button x:Name="ClearGraphButton" Content="Clear graph" Click="ClearGraphButton_Click" />
          <Button x:Name="PauseGraphButton" Content="Pause graph" Click="PauseGraphButton_Click" />
          <Button x:Name="ResetZoomButton" Content="Reset zoom" Click="ResetZoomButton_Click" />
          <TextBlock Text="Graph:" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold" />
          <TextBlock x:Name="GraphStatusTextBlock" Text="Autoscroll" VerticalAlignment="Center" MinWidth="120" />
        </WrapPanel>

        <sp:WpfPlot Grid.Row="1"
                    x:Name="RttPlot"
                    Height="260"
                    MinHeight="220" />

        <TextBlock Grid.Row="2"
                   x:Name="GraphMarkerTextBlock"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Text="Markers: -" />
      </Grid>
    </GroupBox>

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Application name" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApplicationNameTextBox" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="WGB address" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="WgbAddressTextBox" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="SSH port" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="SshPortTextBox" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="SSH username" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="SshUsernameTextBox" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="SSH password" Style="{StaticResource FieldLabelStyle}" />
          <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="SshPasswordBox" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="WGB poll interval seconds" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="5" Grid.Column="1" x:Name="WgbPollIntervalSecondsTextBox" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="WGB command" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="6" Grid.Column="1" x:Name="WgbCommandTextBox" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Parser profile" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="7" Grid.Column="1" x:Name="ParserProfileTextBox" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Ping target" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="8" Grid.Column="1" x:Name="PingTargetTextBox" />

          <TextBlock Grid.Row="9" Grid.Column="0" Text="Ping interval milliseconds" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="9" Grid.Column="1" x:Name="PingIntervalMillisecondsTextBox" />

          <TextBlock Grid.Row="10" Grid.Column="0" Text="Ping timeout milliseconds" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="10" Grid.Column="1" x:Name="PingTimeoutMillisecondsTextBox" />

          <TextBlock Grid.Row="11" Grid.Column="0" Text="Loss threshold milliseconds" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="11" Grid.Column="1" x:Name="LossThresholdMillisecondsTextBox" />

          <TextBlock Grid.Row="12" Grid.Column="0" Text="Raw logging" Style="{StaticResource FieldLabelStyle}" />
          <CheckBox Grid.Row="12" Grid.Column="1" x:Name="RawLoggingEnabledCheckBox" Margin="0,0,0,8" />

          <TextBlock Grid.Row="13" Grid.Column="0" Text="Log directory" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="13" Grid.Column="1" x:Name="LogDirectoryTextBox" />

          <TextBlock Grid.Row="14" Grid.Column="0" Text="Daily rotation" Style="{StaticResource FieldLabelStyle}" />
          <CheckBox Grid.Row="14" Grid.Column="1" x:Name="DailyRotationEnabledCheckBox" Margin="0,0,0,8" />

          <TextBlock Grid.Row="15" Grid.Column="0" Text="Retention days" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="15" Grid.Column="1" x:Name="RetentionDaysTextBox" />

          <TextBlock Grid.Row="16" Grid.Column="0" Text="Graph visible minutes" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="16" Grid.Column="1" x:Name="GraphVisibleMinutesTextBox" />

          <TextBlock Grid.Row="17" Grid.Column="0" Text="WGB log collection enabled" Style="{StaticResource FieldLabelStyle}" />
          <CheckBox Grid.Row="17" Grid.Column="1" x:Name="WgbLogCollectionEnabledCheckBox" Margin="0,0,0,8" />

          <TextBlock Grid.Row="18" Grid.Column="0" Text="TFTP timeout seconds" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="18" Grid.Column="1" x:Name="TftpTimeoutSecondsTextBox" />

          <TextBlock Grid.Row="19" Grid.Column="0" Text="Maximum received file size bytes" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Grid.Row="19" Grid.Column="1" x:Name="MaximumReceivedFileSizeBytesTextBox" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <ListBox Grid.Row="5"
             x:Name="ValidationErrorsListBox"
             MaxHeight="110"
             Margin="0,12,0,12"
             Visibility="Collapsed" />

    <DockPanel Grid.Row="6" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="SaveSettingsButton" Content="Save settings" Click="SaveSettingsButton_Click" />
        <Button x:Name="ReloadSettingsButton" Content="Reload settings" Click="ReloadSettingsButton_Click" />
        <Button x:Name="ResetToDefaultsButton" Content="Reset to defaults" Click="ResetToDefaultsButton_Click" />
        <Button x:Name="OpenLogFolderButton" Content="Open log folder" Click="OpenLogFolderButton_Click" />
        <Button x:Name="OpenCurrentSessionButton" Content="Open current session" Click="OpenCurrentSessionButton_Click" IsEnabled="False" />
      </StackPanel>

      <StackPanel VerticalAlignment="Center">
        <TextBlock TextAlignment="Right" TextWrapping="Wrap">
          <Run Text="Current session: " />
          <Run x:Name="CurrentSessionTextBlock" Text="-" />
        </TextBlock>
        <TextBlock x:Name="StatusTextBlock"
                   TextAlignment="Right"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
