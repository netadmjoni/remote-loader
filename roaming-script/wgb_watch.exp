#!/usr/bin/expect -f
# Usage:
#   ./wgb_compact.exp <host> <user> "<loginpw>" "<enablepw>" [interval]
#
# Example:
#   ./wgb_compact.exp 10.194.240.11 admin "LOGIN" "ENABLE" 1

set timeout 8
exp_internal 0

set host     [lindex $argv 0]
set user     [lindex $argv 1]
set loginpw  [lindex $argv 2]
set enablepw [lindex $argv 3]
set interval [lindex $argv 4]
if {$interval eq ""} { set interval 1 }

# Do NOT print the raw SSH output (we print our own clean line)
log_user 0

spawn ssh -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=10 $user@$host

expect {
  -re {Are you sure you want to continue connecting} { send "yes\r"; exp_continue }
  -re {[Pp]assword:} { send "$loginpw\r" }
  timeout { puts "ERROR: SSH login timed out"; exit 1 }
}

expect {
  -re {>$} { send "enable\r" }
  -re {#$} { }
  timeout { puts "ERROR: No prompt after login"; exit 1 }
}

expect {
  -re {[Pp]assword:} { send "$enablepw\r"; expect -re {#$} }
  -re {#$} { }
  timeout { puts "ERROR: Enable timed out"; exit 1 }
}

send "terminal length 0\r"
expect -re {#$}

proc field_after_colon {line} {
  if {[regexp {:[[:space:]]*(.*)$} $line -> val]} {
    return [string trim $val]
  }
  return ""
}

while {1} {
  send "show wgb dot11 associations\r"
  expect -re {#$}

  set buf $expect_out(buffer)

  set ap ""
  set rssi ""
  set ch ""
  set rate ""
  set radio ""

  foreach rawline [split $buf "\n"] {
    set line [string trim [string map {"\r" ""} $rawline]]

    if {[string first "Parent AP Name" $line] >= 0} {
      set ap [field_after_colon $line]
    } elseif {[string first "RSSI" $line] >= 0} {
      set rssi [field_after_colon $line]
    } elseif {[string first "Channel" $line] >= 0} {
      set ch [field_after_colon $line]
    } elseif {[string first "Current Datarate (Tx/Rx)" $line] >= 0} {
      set rate [field_after_colon $line]
    } elseif {[string first "Uplink Radio ID" $line] >= 0} {
      set radio [field_after_colon $line]
    }
  }

  set ts [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}]
  puts "$ts AP=$ap RSSI=$rssi CH=$ch RATE=$rate RADIO=$radio"

  sleep $interval
}

